<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 11 새 우클릭 메뉴에 항목을 올리기 위한 "외부 위치 패키지" 선언.
  파일은 담지 않고 이름표(ID)만 주며, 실제 exe/dll 은 설치 폴더에 있다.
  scripts\make-package.ps1 이 이 파일로 서명된 package\dist\ikoPDF.msix 를 만든다.

  - Publisher 는 서명 인증서의 주체(CN=ikoPDF)와 같아야 한다.
  - Clsid 는 crates/shell-ext 의 CLSID_IKOPDF_MENU, crates/converter/src/setup.rs 의 MENU_CLSID 와 같아야 한다.
  - 내용을 바꾸면 Version 을 올리고 make-package.ps1 을 다시 실행한다
    (업데이트된 exe 가 버전이 다르면 패키지를 다시 등록한다).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap10 rescap desktop4 desktop5 com">

  <Identity Name="ikoPDF" Publisher="CN=ikoPDF" Version="1.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>iko PDF 변환</DisplayName>
    <PublisherDisplayName>ikoPDF</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="ko-kr" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="ikoPDF" Executable="ikoPDF.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="iko PDF 변환"
        Description="이미지와 PDF를 우클릭 메뉴에서 서로 변환"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".jpg"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpeg"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jpe"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".jfif"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".png"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".bmp"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".gif"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".tif"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".tiff"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".webp"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
            <desktop5:ItemType Type=".pdf"><desktop5:Verb Id="IkoPdfConvert" Clsid="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" /></desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="iko PDF 변환 우클릭 메뉴">
              <com:Class Id="7B3F0C52-9A4E-4D1B-8E6A-2C5D91F4A7E3" Path="ikopdf_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
